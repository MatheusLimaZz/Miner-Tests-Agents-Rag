# =============================================================================
# MSR-Kit — variáveis de ambiente
# =============================================================================
# Copie para .env (cp .env.example .env) e ajuste. O .env nunca vai para o git.
# O msrkit carrega ./.env antes de cada comando (o Docker também, via compose);
# variável já definida no shell ou no CI tem precedência sobre o arquivo.
# Variável vazia = usa o valor do protocolo YAML.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. PARÂMETROS DA BUSCA
# -----------------------------------------------------------------------------
# Sobrepõem o protocolo (protocols/v0_rag_agents_testing.yaml). Os valores abaixo
# são os definidos para o Estudo E2 e iguais aos do protocolo; `msrkit validate`
# avisa quando o .env diverge dele, e o manifesto de cada execução registra os
# valores efetivos e quais vieram daqui (effective_protocol, env_overrides).

# Janela temporal (§7.5): 01/01/2023 até o data-cutoff (último dia do mês
# anterior à coleta). Formato YYYY-MM-DD.
MSRKIT_WINDOW_SINCE=2023-01-01
MSRKIT_WINDOW_UNTIL=2026-08-31

# Léxico em inglês (§7.1, léxico controlado duplo), termos separados por ";".
# RAG · LLM em geral (oráculo, referência, regressão, falhas) · vocabulário
# acadêmico (H1) · agentes. Nomes de ferramenta ficam no gazetteer, não aqui.
MSRKIT_TERMS="RAG evaluation;RAG testing;retrieval augmented generation evaluation;LLM evaluation;LLM testing;LLM as a judge;eval harness;golden dataset;hallucination detection;prompt regression;red teaming LLM;guardrails evaluation;metamorphic testing LLM;LLM test oracle;agent evaluation;agent testing;agentic evaluation;trajectory evaluation;tool calling evaluation;multi-agent testing"

# Léxico de outro idioma declarado em `languages`: MSRKIT_TERMS_<IDIOMA>, mesmo
# formato. O E2 busca só em inglês (ADR-050).


# -----------------------------------------------------------------------------
# 2. FONTES PRONTAS — coletam sem nenhuma configuração
# -----------------------------------------------------------------------------
# APIs e feeds públicos. Basta ter acesso à internet.
MSRKIT_SOURCES_PUBLIC=hackernews,devto,stackexchange,huggingface,rss

# Opcionais — aumentam as cotas das fontes acima, sem ser obrigatórias:
# Stack Exchange: 300 → 10.000 req/dia. Chave gratuita: registre um app em
# https://stackapps.com/apps/oauth/register e copie o campo "Key" da página do app
# (não o Client Secret; a chave não é segredo). Apps já registrados: https://stackapps.com/apps/oauth
STACKEXCHANGE_KEY=
# Hugging Face: limites maiores. Token gratuito em https://huggingface.co/settings/tokens
HF_TOKEN=


# -----------------------------------------------------------------------------
# 3. FONTES QUE PRECISAM DA SUA CONFIGURAÇÃO MANUAL — credencial gratuita
# -----------------------------------------------------------------------------
# Listadas aqui, entram na coleta assim que a credencial estiver preenchida;
# sem ela, o msrkit pula a fonte e registra o motivo no manifesto.
MSRKIT_SOURCES_MANUAL=github

# GitHub — fonte primária da evidência N2/N3 (busca de código exige token).
# PAT em https://github.com/settings/tokens (clássico sem escopos, ou fine-grained
# só com acesso público de leitura). 5.000 req/h; busca de código 10 req/min.
GITHUB_TOKEN=

# Bluesky — desativado no Estudo E2 (conteúdo curto, sem artefatos de teste).
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=

# Reddit — exige aprovação manual prévia do Reddit (Responsible Builder Policy,
# nov/2025), sem prazo. Desativado no Estudo E2 (ADR-014); se a aprovação sair,
# acrescente reddit em MSRKIT_SOURCES_MANUAL.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="msrkit/0.1 (academic research; contact: <email>)"


# -----------------------------------------------------------------------------
# 4. PAGAS OU INVIÁVEIS — nunca coletadas
# -----------------------------------------------------------------------------
# Fontes nestes grupos ficam desligadas mesmo que o protocolo as habilite.
# Detalhes e fontes consultadas: docs/sources.md.

# Pagas: X/Twitter cobra por post lido (pague-por-uso, desde US$ 0,005/post);
# o adaptador é um stub. Só mude de grupo se houver orçamento e implementação.
MSRKIT_SOURCES_PAID=x_twitter
X_BEARER_TOKEN=

# Inviáveis sem custo ou desativadas: LinkedIn (sem API de busca; termos vedam a coleta),
# Discord (sem busca global; bot autorizado) e Bluesky (desativado no Estudo E2).
MSRKIT_SOURCES_UNAVAILABLE=linkedin,discord,bluesky
DISCORD_BOT_TOKEN=
DISCORD_GUILD_IDS=
